set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

find_program(CIRRUS_CLANG NAMES clang REQUIRED)
find_program(CIRRUS_CLANGXX NAMES clang++ REQUIRED)
find_program(CIRRUS_LLD NAMES ld.lld REQUIRED)
set(CMAKE_C_COMPILER "${CIRRUS_CLANG}")
set(CMAKE_CXX_COMPILER "${CIRRUS_CLANGXX}")
set(CMAKE_ASM_COMPILER "${CIRRUS_CLANG}")
set(CMAKE_C_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_CXX_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_ASM_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=${CIRRUS_LLD}")
# Host tools are built by the outer native CMake project.
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
